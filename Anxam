-- دالة مساعدة لإنشاء السلايدر/مربع الإدخال مع الزر
local function CreateInputRow(labelText, defaultVal, placeholderText)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, -10, 0, 40)
    Row.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    Row.Parent = PlayerPage

    local RowCorner = Instance.new("UICorner")
    RowCorner.CornerRadius = UDim.new(0, 6)
    RowCorner.Parent = Row

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0, 110, 1, 0)
    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.Text = labelText
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextSize = 14
    Label.Font = Enum.Font.SourceSansBold
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.BackgroundTransparency = 1
    Label.Parent = Row

    local Box = Instance.new("TextBox")
    Box.Size = UDim2.new(0, 80, 0, 28)
    Box.Position = UDim2.new(0, 125, 0.5, -14)
    Box.Text = tostring(defaultVal)
    Box.PlaceholderText = placeholderText
    Box.TextColor3 = Color3.fromRGB(0, 170, 255)
    Box.TextSize = 14
    Box.Font = Enum.Font.SourceSansBold
    Box.BackgroundColor3 = Color3.fromRGB(25, 25, 32)
    Box.Parent = Row

    local BoxCorner = Instance.new("UICorner")
    BoxCorner.CornerRadius = UDim.new(0, 4)
    BoxCorner.Parent = Box

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0, 110, 0, 28)
    Btn.Position = UDim2.new(1, -120, 0.5, -14)
    Btn.Text = "تطبيق"
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.TextSize = 13
    Btn.Font = Enum.Font.SourceSansBold
    Btn.BackgroundColor3 = Color3.fromRGB(0, 140, 220)
    Btn.Parent = Row

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 4)
    BtnCorner.Parent = Btn

    return Box, Btn
end

-- 1. زر السرعة (WalkSpeed)
local SpeedBox, SpeedBtn = CreateInputRow("السرعة:", 16, "العدد")
SpeedBtn.MouseButton1Click:Connect(function()
    local val = tonumber(SpeedBox.Text)
    if val and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.WalkSpeed = val
    end
end)

-- 2. زر قوة القفز (JumpPower)
local JumpBox, JumpBtn = CreateInputRow("قوة النط:", 50, "العدد")
JumpBtn.MouseButton1Click:Connect(function()
    local val = tonumber(JumpBox.Text)
    if val and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid.UseJumpPower = true
        LocalPlayer.Character.Humanoid.JumpPower = val
    end
end)

