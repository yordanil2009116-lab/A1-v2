local PlayerPage = Pages["اللاعب"]

local function CreateInputRow(labelText, defaultVal, callback)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, -6, 0, 42)
    Row.BackgroundColor3 = CARD_COLOR
    Row.Parent = PlayerPage

    local RowCorner = Instance.new("UICorner")
    RowCorner.CornerRadius = UDim.new(0, 8)
    RowCorner.Parent = Row

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(0, 110, 1, 0)
    Label.Position = UDim2.new(0, 12, 0, 0)
    Label.Text = labelText
    Label.TextColor3 = TEXT_COLOR
    Label.TextSize = 13
    Label.Font = Enum.Font.GothamBold
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.BackgroundTransparency = 1
    Label.Parent = Row

    local Box = Instance.new("TextBox")
    Box.Size = UDim2.new(0, 85, 0, 28)
    Box.Position = UDim2.new(0, 125, 0.5, -14)
    Box.Text = tostring(defaultVal)
    Box.TextColor3 = ACCENT_BLUE
    Box.TextSize = 13
    Box.Font = Enum.Font.GothamBold
    Box.BackgroundColor3 = Color3.fromRGB(16, 17, 24)
    Box.Parent = Row

    local BoxCorner = Instance.new("UICorner")
    BoxCorner.CornerRadius = UDim.new(0, 6)
    BoxCorner.Parent = Box

    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(0, 90, 0, 28)
    Btn.Position = UDim2.new(1, -98, 0.5, -14)
    Btn.Text = "تطبيق"
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.TextSize = 12
    Btn.Font = Enum.Font.GothamBold
    Btn.BackgroundColor3 = ACCENT_BLUE
    Btn.Parent = Row

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = Btn

    Btn.MouseButton1Click:Connect(function()
        local val = tonumber(Box.Text)
        if val then callback(val) end
    end)
end

local function CreateToggleBtn(btnText, parentPage)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1, -6, 0, 38)
    Btn.Text = btnText
    Btn.TextColor3 = TEXT_COLOR
    Btn.TextSize = 13
    Btn.Font = Enum.Font.GothamBold
    Btn.BackgroundColor3 = CARD_COLOR
    Btn.Parent = parentPage or PlayerPage

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 8)
    BtnCorner.Parent = Btn

    return Btn
end

