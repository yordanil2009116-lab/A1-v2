local Tabs = {"اللاعب", "الأنيميشنات", "استهداف", "المواقع", "قائمة جديدة"}
local Pages = {}
local TabButtons = {}

for i, tabName in ipairs(Tabs) do
    local Page = Instance.new("ScrollingFrame")
    Page.Size = UDim2.new(1, -12, 1, -12)
    Page.Position = UDim2.new(0, 6, 0, 6)
    Page.BackgroundTransparency = 1
    Page.Visible = (i == 1)
    Page.ScrollBarThickness = 3
    Page.ScrollBarImageColor3 = ACCENT_BLUE
    Page.CanvasSize = UDim2.new(0, 0, 0, 450)
    Page.Parent = Container
    Pages[tabName] = Page

    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(1, 0, 0, 36)
    TabBtn.Text = tabName
    TabBtn.TextColor3 = (i == 1) and ACCENT_BLUE or Color3.fromRGB(160, 160, 175)
    TabBtn.TextSize = 13
    TabBtn.Font = Enum.Font.GothamBold
    TabBtn.BackgroundColor3 = (i == 1) and CARD_COLOR or Color3.fromRGB(22, 23, 32)
    TabBtn.Parent = TabBar

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = TabBtn

    TabButtons[tabName] = TabBtn

    TabBtn.MouseButton1Click:Connect(function()
        for name, p in pairs(Pages) do
            p.Visible = false
            TabButtons[name].BackgroundColor3 = Color3.fromRGB(22, 23, 32)
            TabButtons[name].TextColor3 = Color3.fromRGB(160, 160, 175)
        end
        Pages[tabName].Visible = true
        TabBtn.BackgroundColor3 = CARD_COLOR
        TabBtn.TextColor3 = ACCENT_BLUE
    end)
end

